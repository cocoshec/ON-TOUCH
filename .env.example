# Puerto del servidor Node
PORT=3000

# Credenciales SMTP para el formulario de contacto
SMTP_HOST=smtp.tuproveedor.com
SMTP_PORT=587
SMTP_SECURE=false          # true si usas el puerto 465
SMTP_USER=usuario@on-touch.net
SMTP_PASS=tu-contrasena

# Remitente y destinatario de los mensajes del formulario
SMTP_FROM=no-reply@on-touch.net
TO_EMAIL=clientes@on-touch.net

# --- Subida al hosting (tools/subir.py) ---
FTP_HOST=on-touch.net
FTP_USER=clientes@on-touch.net
FTP_PASS=tu-contrasena
# La carpeta real donde vive el sitio (cPanel > Domains > Document Root).
# Compruébala siempre ahí: NO uses la carpeta que cPanel sugiere por
# defecto al crear la cuenta FTP, puede no coincidir.
FTP_DIR=/public_html
FTP_TLS=true
